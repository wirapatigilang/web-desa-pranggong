# Salin file ini jadi `.env` lalu isi nilai sungguhan. Jangan commit `.env`.

# Koneksi PostgreSQL. Lokal: `createdb <nama_db>` lalu isi URL di bawah.
DATABASE_URL="postgresql://user@localhost:5432/nama_db?schema=public"

# Better Auth — generate secret acak, contoh: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Dipakai SEKALI oleh `prisma/seed.ts` untuk membuat akun admin pertama.
# Tidak ada form pendaftaran publik — ini satu-satunya cara membuat akun admin.
# Setelah seed berhasil, boleh dihapus dari .env (akun sudah tersimpan di database).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
